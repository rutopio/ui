      "types": "./dist/page-share.d.ts",
      "import": "./dist/page-share.js"
    },
    "./section-navigation": {
      "types": "./dist/section-navigation.d.ts",
      "import": "./dist/section-navigation.js"
    },
    "./styles.css": "./dist/styles.css"
