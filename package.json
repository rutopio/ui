    },
    "./drawer": {
      "types": "./dist/drawer.d.ts",
      "import": "./dist/drawer.js"
    },
    "./action-menu": {
      "types": "./dist/action-menu.d.ts",
      "import": "./dist/action-menu.js"
    },
    "./outline-list": {
      "types": "./dist/outline-list.d.ts",
      "import": "./dist/outline-list.js"
    },
    "./button-group": {
      "types": "./dist/button-group.d.ts",
      "import": "./dist/button-group.js"
    },
    "./fluid-hover-controls": {
      "types": "./dist/fluid-hover-controls.d.ts",
      "import": "./dist/fluid-hover-controls.js"
    },
    "./footer": {
      "types": "./dist/footer.d.ts",
      "import": "./dist/footer.js"
    },
    "./page-action-rail": {
      "types": "./dist/page-action-rail.d.ts",
      "import": "./dist/page-action-rail.js"
    },
    "./site-header": {
      "types": "./dist/site-header.d.ts",
      "import": "./dist/site-header.js"
    },
