    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@types/react": "19.2.17",
    "motion": "12.40.0",
    "react": "19.2.7",
